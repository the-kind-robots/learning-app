# Template for ${XDG_CONFIG_HOME:-$HOME/.config}/learning-app/google-tasks.env
#
# Copy it there, edit it, and chmod 600 it. Never commit the filled-in file:
# this repository is public. Both variables can also be set in the environment,
# which wins over this file.
#
# Shell assignments only, values quoted.

# Path to the OAuth client JSON downloaded from the Google Cloud Console.
# Default: ${XDG_CONFIG_HOME:-$HOME/.config}/learning-app/google-tasks-client.json
GOOGLE_TASKS_CLIENT_JSON="$HOME/.config/learning-app/google-tasks-client.json"

# Task list to read by default, by title or by id. `lists` prints both.
# "@default" is the account's default list, which is often the right answer.
GOOGLE_TASKS_LIST="@default"
