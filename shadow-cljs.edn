{:dependencies
 [[binaryage/devtools "1.0.7"]
  [cheshire/cheshire "6.2.0"]
  [cider/cider-nrepl "0.62.2"]
  [com.lambdaisland/glogi "1.4.177"]
  [metosin/reitit "0.10.1"]
  [no.cjohansen/dataspex "2026.06.3"]
  [no.cjohansen/nexus "2026.07.1"]
  [no.cjohansen/replicant "2026.07.1"]
  ;; Tests only: property tests (`client.memory-test`). Nothing the app
  ;; requires, so no build but node-test compiles it.
  [org.clojure/test.check "1.1.3"]

  [philoskim/debux "0.9.1"]
  [refactor-nrepl/refactor-nrepl "3.14.0"]

  ;; These dependencies keep the shared application.cljc build green.
  ;; They are not used in cljs code, but the compiler fails unless they
  ;; are present because application.cljc references the backend APIs.
  [com.taoensso/telemere "1.4.0"]
  [http-kit/http-kit "2.8.1"]]

 ;; `dev/clj` carries build hooks, which are Clojure and run in the compiler's
 ;; own JVM. It is a source path of its own rather than `dev`, which holds a
 ;; `user.clj` Clojure loads on startup and whose dependencies are the
 ;; backend's, not the compiler's.
 :source-paths
 ["lib/db/src" "src/shared" "src/client" "dev/cljs" "dev/clj" "test"]

 ;; nginx proxies /shadow-cljs/ to 9630 on every host it serves, so the
 ;; devtools socket only reaches a watch that holds that exact port. The
 ;; port alone does not pin it: on a BindException `start-http` retries the
 ;; next free port and says so in a warning nobody reads, which is how a
 ;; second watch on this machine ends up on 9631 while nginx answers 502.
 ;; `:strict` makes that bind failure fatal instead. No `:ssl` and no
 ;; `:host`: TLS ends at the tunnel and at nginx, which proxies to plain
 ;; http, and the host already defaults to 0.0.0.0.
 :http
 {:port   9630
  :strict true}

 :nrepl
 {:port 4444
  :middleware
  [cider.nrepl/cider-middleware
   refactor-nrepl.middleware/wrap-refactor]}

 :dev-http
 {8021 "target/browser-test"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/app"
   :asset-path "/js/app"
   :modules    {:main {:init-fn main/start}}
   :js-options {:js-provider :shadow}
   ;; Stamps the development bundle with the checkout it came from. The hook
   ;; itself is what skips a release build, so this stays one line either way.
   :build-hooks [(dev.build-identity/stamp-the-build)]
   :devtools
   {:preloads     [dev.devtools-socket debux.preloads]
    :watch-dir    "resources/public/css"
    :watch-path   "/css"}
   :release-stubs #{debux.core}}

  :node-test
  {:target    :node-test
   :output-to "target/node-tests.js"
   :autorun   true
   :ns-regexp "-test$"}

  :browser-test
  {:target    :browser-test
   :test-dir  "target/browser-test"
   :ns-regexp "-test$"}}}
