{:dependencies
 [[binaryage/devtools "1.0.7"]
  [cheshire/cheshire "6.2.0"]
  [cider/cider-nrepl "0.59.0"]
  [com.lambdaisland/glogi "1.3.169"]
  [metosin/reitit "0.10.1"]
  [no.cjohansen/dataspex "2026.04.1"]
  [no.cjohansen/nexus "2025.11.1"]
  [no.cjohansen/replicant "2025.12.1"]

  [philoskim/debux "0.9.1"]
  [refactor-nrepl/refactor-nrepl "3.11.0"]

  ;; These dependencies keep the shared application.cljc build green.
  ;; They are not used in cljs code, but the compiler fails unless they
  ;; are present because application.cljc references the backend APIs.
  [com.taoensso/telemere "1.2.1"]
  [http-kit/http-kit "2.8.1"]]

 :source-paths
 ["lib/db/src" "src/shared" "src/client" "dev/cljs" "test"]

 :nrepl
 {:port 4444
  :middleware
  [cider.nrepl/cider-middleware
   refactor-nrepl.middleware/wrap-refactor]}

 :dev-http
 {8021 "target/browser-test"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/app"
   :asset-path "/js/app"
   :modules    {:main {:init-fn main/start}}
   :js-options {:js-provider :shadow}
   :devtools
   {:devtools-url "https://sprecha.local/shadow-cljs"
    :preloads     [debux.preloads]
    :watch-dir    "resources/public/css"
    :watch-path   "/css"}
   :release-stubs #{debux.core}}

  :node-test
  {:target    :node-test
   :output-to "target/node-tests.js"
   :autorun   true
   :ns-regexp "-test$"}

  :browser-test
  {:target    :browser-test
   :test-dir  "target/browser-test"
   :ns-regexp "-test$"}}}
