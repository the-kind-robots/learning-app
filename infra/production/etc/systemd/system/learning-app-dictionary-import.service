[Unit]
Description=Import dictionary data into CouchDB
After=network.target couchdb.service
Requires=couchdb.service

[Service]
Type=oneshot
User=webapp
WorkingDirectory=/var/lib/learning-app/dictionary
ExecStart=sh -c "COUCHDB_PASS=${COUCHDB_PASS:-$(cat ${COUCHDB_PASS_PATH})} exec /opt/learning-app/dictionary/import.sh --db dictionary-db --reset"
# --reset drops the database, and with it the CouchDB indexes the app queries
# through. The app creates them as it starts, so the import restarts it — here
# rather than in the deploy workflow, because the runbook also has an operator
# start this unit by hand, and that path would otherwise leave every dictionary
# lookup scanning the whole dictionary until someone restarted the app for an
# unrelated reason (GH-436). ExecStartPost runs only when ExecStart succeeded.
# The "+" prefix is what lets it reach PID 1: this unit runs as webapp with an
# empty capability bounding set, and uid 0 is what satisfies polkit's
# manage-units check.
ExecStartPost=+systemctl start learning-app-restart.service

# Environment
EnvironmentFile=-/etc/learning-app/environment
EnvironmentFile=-/etc/environment.d/learning-app.conf
LoadCredentialEncrypted=couchdb_admin_password:/etc/credstore.encrypted/couchdb_admin_password
Environment=COUCHDB_URL=http://127.0.0.1:5984
Environment=COUCHDB_USER=admin
Environment=COUCHDB_PASS_PATH=%d/couchdb_admin_password

# Security settings
#
# What this service actually needs: JVM as user webapp, reads dump files from
# the working directory (gunzip staging goes to private /tmp), pushes documents
# to CouchDB on 127.0.0.1:5984, reads the decrypted credential from %d.
#
# No privilege gain on execve; nothing here elevates.
NoNewPrivileges=yes
# import.sh stages gunzipped dumps in /tmp; keep it private.
PrivateTmp=yes
# No /home access needed.
ProtectHome=yes
# Filesystem read-only except the drop directory below.
ProtectSystem=strict
# The deployer/webapp drop directory stays writable, matching its 2770 mode.
ReadWritePaths=/var/lib/learning-app/dictionary
# Only pseudo-devices; urandom/null suffice for the JVM.
PrivateDevices=yes
# Kernel interfaces read-only or unreachable.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# No setuid/setgid files, namespaces, realtime, or personality changes.
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# TCP to CouchDB; AF_UNIX for journald and NSS lookups.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Unprivileged user: zero capabilities needed.
CapabilityBoundingSet=
# Native-ABI syscalls only, filtered to the standard service set.
SystemCallArchitectures=native
SystemCallFilter=@system-service
# MemoryDenyWriteExecute stays OFF: the HotSpot JIT maps writable+executable
# pages for compiled code; enabling it kills the JVM at startup.

[Install]
WantedBy=multi-user.target
