{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(clj *)",
      "Bash(clojure *)",
      "Bash(curl *)",
      "Bash(openspec *)",
      "Bash(npx shadow-cljs *)",
      "Bash(npm *)",
      "Bash(sqlite3 *)",
      "Bash(clj-kondo *)",
      "Bash(clojure-lsp *)",
      "Bash(zprint *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/*.sh *)",
      "Bash(bash .claude/skills/learning-app-cdp/scripts/*.sh *)",
      "Bash(bash .claude/skills/session-supervisor/scripts/*.sh *)",
      "Bash(clj-nrepl-eval *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(kill *)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'g=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/supervisor-start.sh\"; [ -r \"$g\" ] || exit 0; exec bash \"$g\"'",
            "timeout": 30,
            "statusMessage": "Collecting background sessions..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'g=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/delivery-guard.sh\"; [ -r \"$g\" ] || g=.claude/hooks/delivery-guard.sh; [ -r \"$g\" ] || exit 0; exec bash \"$g\"'",
            "timeout": 10,
            "statusMessage": "Checking delivery flow..."
          }
        ]
      }
    ]
  },
  "env": {
    "GHWF_OWNER": "the-kind-robots",
    "GHWF_REPO": "the-kind-robots/learning-app",
    "GHWF_PROJECT_NUMBER": "11",
    "GHWF_DEFAULT_BASE": "master"
  },
  "bashOutputMaxChars": 15000
}
