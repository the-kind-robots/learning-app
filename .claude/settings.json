{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(clj *)",
      "Bash(clojure *)",
      "Bash(curl *)",
      "Bash(openspec *)",
      "Bash(npx shadow-cljs *)",
      "Bash(npm *)",
      "Bash(sqlite3 *)",
      "Bash(clj-kondo *)",
      "Bash(clojure-lsp *)",
      "Bash(zprint *)",
      "Bash(bash .skills/install.sh *)",
      "Bash(OPENSPEC_TELEMETRY=0 openspec *)",
      "Bash(GHWF_OWNER=* bash *)",
      "Bash(bash .skills/gh-project-workflow/scripts/*.sh *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/*.sh *)",
      "Bash(bash .codex/skills/gh-project-workflow/scripts/*.sh *)",
      "Bash(bash .skills/learning-app-cdp/scripts/*.sh *)",
      "Bash(bash .claude/skills/learning-app-cdp/scripts/*.sh *)",
      "Bash(clj-nrepl-eval *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(kill *)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'g=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/delivery-guard.sh\"; [ -r \"$g\" ] || g=.claude/hooks/delivery-guard.sh; [ -r \"$g\" ] || exit 0; exec bash \"$g\"'",
            "timeout": 10,
            "statusMessage": "Checking delivery flow..."
          }
        ]
      }
    ]
  }
}
